# Optional approved Quran Foundation production Content API credentials.
# Leave empty to use the currently available public legacy Quran.com API.
# Set these only on your server; never use a NEXT_PUBLIC prefix.
QURAN_CLIENT_ID=
QURAN_CLIENT_SECRET=

# Optional comma-separated Site-scoped administrator user IDs. Required BEFORE
# changing this owner-private site's audience to public or shared access.
# ChatGPT identity is supplied by the trusted Sites gateway, never by the client.
SITE_ADMIN_USER_IDS=
